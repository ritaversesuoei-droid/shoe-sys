# ============================================================
# 昭栄運輸 運行・勤怠管理システム 環境変数サンプル
# .env.local にコピーして実値を設定してください（.env.local はコミット禁止）。
# ============================================================

# ---- Supabase ----
# ブラウザ公開可能（anon key, RLS で保護）
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# サーバー専用（service_role: RLS をバイパスする。絶対に公開しない / NEXT_PUBLIC_ を付けない）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- LINE Messaging API（管理者通知 push 用 / 仕様書 F-16, 12.1-#1）----
# トークン・シークレットはコード直書き禁止。環境変数のみ。
LINE_CHANNEL_ACCESS_TOKEN=your-channel-access-token
LINE_CHANNEL_SECRET=your-channel-secret

# ---- LINE LIFF（ドライバー認証 / 仕様書 F-01）----
# LIFF は Messaging API チャネルにそのまま追加できる（別途 LINEログインチャネルは不要）。
#   LINE Developers Console → プロバイダー → 該当 Messaging API チャネル → 「LIFF」タブ → 追加。
#   endpoint URL = 「https://（本番URL）/driver」、scope = profile,openid。
NEXT_PUBLIC_LIFF_ID=your-liff-id
# ↑LIFFを追加したチャネルのチャネルID（IDトークン検証の aud）。
#   Messaging API チャネルに LIFF を追加した場合は、その Messaging API チャネルの
#   「チャネルID」（Basic settings の数値ID。@基本ID や userId とは別物）を設定する。
LINE_LOGIN_CHANNEL_ID=your-login-channel-id

# 管理者へ警告/業務報告を push する宛先（グループ or ユーザーID）
LINE_ADMIN_TARGET_ID=your-admin-target-id

# ---- アプリ ----
# 署名付きURL生成や絶対URL組み立てに使用
NEXT_PUBLIC_APP_URL=http://localhost:3000
# JST 固定運用。タイムゾーンの基準（仕様書 11.2 移行リスク: 時刻表記ゆれ対策）
APP_TIMEZONE=Asia/Tokyo

# ---- PDF生成（F-17/18）----
# サーバーのChrome/Chromium実行パス。未設定時は環境依存の既定を探索。
PUPPETEER_EXECUTABLE_PATH=

# ---- 据置端末（S-08/09）----
OFFICE_TERMINAL_TOKEN=

# ---- 逆ジオコーディング（F-22）----
# gsi(既定,無料・日本) / google(GOOGLE_MAPS_API_KEY必須) / none
GEOCODER=gsi
GOOGLE_MAPS_API_KEY=

# 配車「流れ表」連携（TROUD由来 Googleスプレッドシート → dispatch_plans）
# 既定は公開シートのCSVエクスポートを直接取得（未設定でOK）。差し替え時のみ指定。
# DISPATCH_SHEET_ID=1yXWWA-wAyUyX2NCrmMcf5RkTCLUonWHPwQH9a39iH6Y
# DISPATCH_SHEET_GID=0
# DISPATCH_SHEET_CSV_URL=（完全なCSVエクスポートURLで上書きする場合）

# ── 並行運用ミラー（現行スプレッドシート → shoei-sys 片方向コピー）──────────────
# 現行を"正"のまま、勤怠・打刻・配車を新システムへ定期コピーする。1時間ごとに自動実行
# （GitHub Actions .github/workflows/hourly-mirror.yml が /api/cron/mirror を毎時起動）。
#   ※ Vercel Hobby プランは毎時Cronが使えないため GitHub Actions 方式。Proなら vercel.json に
#     "crons":[{"path":"/api/cron/mirror","schedule":"0 * * * *"}] を足してネイティブ実行も可。
# 手動実行は管理画面の「🔁 現行から全同期」ボタン。
# 有効化には CRON_SECRET と MIRROR_SHEET_ID（勤怠ブックを「リンクを知っている全員が閲覧可」で共有）だけでOK。
# 既定タブ名 drivers/vehicles/客先マスタ/shift_log/event_log をシート名指定(gviz)で取得するため gid 不要。
# CRON_SECRET=（任意の長いランダム文字列。Vercel環境変数とGitHub Secretの両方に同じ値を設定）
# MIRROR_SHEET_ID=（勤怠ブックのスプレッドシートID。例 114mp0U204ps2sigd9y18ImDDb9AlkvtaHzDNiINQFCM）
# MIRROR_WINDOW_DAYS=21   （直近何日ぶんを毎回処理するか。既定21。初回の全期間投入は npm run migrate:all）
# （任意）タブ名やgidが異なる場合の上書き: MIRROR_NAME_SHIFTLOG / MIRROR_GID_SHIFTLOG 等（KEY=DRIVERS/VEHICLES/CUSTOMERS/SHIFTLOG/EVENTLOG）
# ※ 配車は上の DISPATCH_SHEET_* を使ってミラーが自動で一緒に取り込む。

# TROUD 直連携の取込口（POST /api/troud/sync）を有効化するシークレット。
# TROUD側（またはコネクタ）から Authorization: Bearer <値> で行データ(JSON)を送る受け口。
# 既定は受信しても書き込まない（配車表の手修正を守るため）。実際に反映するには TROUD_AUTO_APPLY=1 も設定。
# TROUD_SYNC_SECRET=（任意の長いランダム文字列）
# TROUD_AUTO_APPLY=1   （TROUDからの受信を dispatch_plans に自動反映する場合のみ）
